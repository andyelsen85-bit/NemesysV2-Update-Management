<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="NemesysV2 Client"
    Manufacturer="NemesysV2"
    Version="$(var.MsiVersion)"
    UpgradeCode="{C1D2B3A4-5E6F-4789-8012-34567890ABCD}"
    Scope="perMachine"
    Compressed="yes">
    <MajorUpgrade
      Schedule="afterInstallExecute"
      DowngradeErrorMessage="A newer NemesysV2 Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NemesysV2 Client" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="NemesysV2 Client" Level="1">
      <ComponentGroupRef Id="ClientFiles" />
    </Feature>

    <Property Id="NEMESYS_SERVER" Secure="yes" />
    <Property Id="NEMESYS_PORT" Value="443" Secure="yes" />
    <Property Id="NEMESYS_API_KEY" Hidden="yes" Secure="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Binary
      Id="NemesysV2ServicePreparation"
      SourceFile="$(var.ClientPublishDir)\NemesysV2.Client.exe" />

    <CustomAction
      Id="PrepareMsiService"
      BinaryRef="NemesysV2ServicePreparation"
      ExeCommand="/prepare-msi"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <CustomAction
      Id="ConfigureClient"
      FileRef="NemesysV2ClientExe"
      ExeCommand="/configure /server &quot;[NEMESYS_SERVER]&quot; /port [NEMESYS_PORT] /apiKey &quot;[NEMESYS_API_KEY]&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <CustomAction
      Id="RemoveClientData"
      FileRef="NemesysV2ClientExe"
      ExeCommand="/uninstall"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="PrepareMsiService" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="ConfigureClient" After="PrepareMsiService" Condition="NEMESYS_SERVER AND NEMESYS_API_KEY" />
      <Custom Action="RemoveClientData" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ClientFiles" Directory="INSTALLFOLDER">
      <Component Id="ClientExecutable" Bitness="always64">
        <File Id="NemesysV2ClientExe" Source="$(var.ClientPublishDir)\NemesysV2.Client.exe" KeyPath="yes" />
        <ServiceInstall
          Id="NemesysV2Service"
          Name="NemesysV2Client"
          DisplayName="NemesysV2 Client"
          Description="NemesysV2 Windows software update client"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem" />
        <ServiceControl
          Id="NemesysV2ServiceControl"
          Name="NemesysV2Client"
          Start="install"
          Stop="install"
          Wait="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>